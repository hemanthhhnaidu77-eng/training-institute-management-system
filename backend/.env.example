# ---------------------------------------------------------------
# Training Institute API configuration
# Copy this file to ".env" and change every value marked CHANGE.
# Never commit your real .env file.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins (must match the Angular dev server)
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# CHANGE: long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REMEMBER_EXPIRES_IN=7d

# bcrypt cost factor (10-14 is sensible; higher = slower + safer)
BCRYPT_ROUNDS=12

# Optional: custom data directory (defaults to backend/data)
# DATA_DIR=C:\\training-data

# Development mail sink. No real email service is configured, so password-reset
# messages are written to data/outbox.json instead of being sent.
# Leave false in production unless you plug in a real mail transport.
DEV_MAIL_OUTBOX=true

# Optional seed credentials (used only by "npm run seed").
# If empty, strong random passwords are generated and printed ONCE to your terminal.
SEED_ADMIN_EMAIL=admin@institute.local
SEED_ADMIN_PASSWORD=
SEED_TRAINER_PASSWORD=

# Set to true only when running behind a reverse proxy (affects rate limiting by IP)
TRUST_PROXY=false

{
  "name": "training-institute-backend",
  "version": "1.0.0",
  "description": "Express REST API with JSON-file storage for the Training Institute Management System",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-data": "node scripts/init-data.js",
    "seed": "node scripts/seed.js",
    "create-user": "node scripts/create-user.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
